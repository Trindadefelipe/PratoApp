# Copie este arquivo para ".env" (na mesma pasta) e preencha.
# O .env NÃO vai para o Git: a URL abaixo tem a senha do banco.

# Supabase > botão "Connect" no topo do projeto > "Session pooler" > copie a URL
# e troque [YOUR-PASSWORD] pela senha do banco.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Porta da API no computador (o app usa http://<ip-do-computador>:3333).
PORT=3333
